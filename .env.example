# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Optional custom production domain for SEO canonicals and sitemaps.
# Defaults to the deployed Cloud Run domain or https://qrcodescanner.app. Never uses localhost.
VITE_SITE_URL=""

# Google AdSense Monetization (Disabled by default)
# VITE_ADS_ENABLED: Master toggle for advertisements (must be "true" to activate).
VITE_ADS_ENABLED="false"
# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
VITE_ADSENSE_CLIENT_ID=""
# VITE_ADS_TEST_MODE: Set to "true" to preview ad bounding boxes in development without live AdSense scripts.
VITE_ADS_TEST_MODE="false"
