# APP_URL: Canonical hosting URL for QR Here in production environments.
APP_URL="https://qrhere.online"

# VITE_SITE_URL: Canonical production domain for SEO canonical tags, OpenGraph, and sitemaps.
# Defaults to https://qrhere.online.
VITE_SITE_URL="https://qrhere.online"

# Google AdSense Monetization (Disabled by default)
# VITE_ADS_ENABLED: Master toggle for advertisements (must be "true" to activate).
VITE_ADS_ENABLED="false"
# VITE_ADSENSE_CLIENT_ID: Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
VITE_ADSENSE_CLIENT_ID=""
# VITE_ADS_TEST_MODE: Set to "true" to preview ad bounding boxes in development without live AdSense scripts.
VITE_ADS_TEST_MODE="false"
