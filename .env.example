# APP_URL: Canonical hosting URL for QR Here in production environments.
APP_URL="https://qrhere.online"

# VITE_SITE_URL: Canonical production domain for SEO canonical tags, OpenGraph, and sitemaps.
# Defaults to https://qrhere.online.
VITE_SITE_URL="https://qrhere.online"

# Google AdSense Auto Ads Configuration
# VITE_ADS_ENABLED: Set to "true" to enable Google AdSense Auto ads globally.
VITE_ADS_ENABLED="true"
# VITE_ADSENSE_CLIENT_ID: Your Google AdSense Publisher Client ID (e.g. ca-pub-1234567890123456 or pub-1234567890123456).
VITE_ADSENSE_CLIENT_ID=""
# VITE_ADS_TEST_MODE: Set to "false" for live production Auto ads, or "true" to disable script injection in development.
VITE_ADS_TEST_MODE="false"
